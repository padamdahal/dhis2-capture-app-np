    "scripts": {
        "dev": "tsx server.ts",
        "start": "NODE_ENV=production tsx server.ts",
        "start:prod": "npm run build && npm run start",
        "build": "npm run nepal:brand && node nepal/scripts/buildRulesEngineCached.mjs && npm run nepal:build-ext && npm run verifyCacheVersion && DHIS2_CACHE_VERSION=4 NODE_OPTIONS=\"--max-old-space-size=1792\" GENERATE_SOURCEMAP=false d2-app-scripts build --standalone --no-pack",
        "build:standalone": "npm run build",
        "build:zip": "npm run nepal:brand && node nepal/scripts/buildRulesEngineCached.mjs && npm run nepal:build-ext && npm run verifyCacheVersion && DHIS2_CACHE_VERSION=4 NODE_ENV=production NODE_OPTIONS=\"--max-old-space-size=1792\" GENERATE_SOURCEMAP=false d2-app-scripts build",
        "pack": "d2-app-scripts pack",
        "nepal:brand": "node nepal/scripts/applyBranding.mjs",
        "nepal:build-ext": "node nepal/scripts/buildExtension.mjs --out public",
        "nepal:build-fast": "node nepal/scripts/buildFast.mjs",
        "nepal:overlay": "node nepal/scripts/applyOverlayToBase.mjs",
        "nepal:export-repo": "node nepal/scripts/exportNepalRepo.mjs",
        "nepal:verify": "node nepal/scripts/verifyIntegration.mjs",
        "nepal:check-updates": "node nepal/scripts/syncUpstream.mjs --check",
        "nepal:sync": "node nepal/scripts/syncUpstream.mjs",
        "nepal:sync:dry-run": "node nepal/scripts/syncUpstream.mjs --dry-run",
        "nepal:upgrade": "bash nepal/scripts/upgradeUpstream.sh",
        "lint": "NODE_OPTIONS=\"--max-old-space-size=1024\" ./node_modules/.bin/tsc --noEmit",
        "tsc:check": "./node_modules/.bin/tsc --noEmit && npm run tsc:check --workspace=packages/rules-engine",
        "verifyCacheVersion": "node scripts/verifyCacheVersion.js",
        "postinstall": "patch-package && node scripts/createSymlinkToInternalPackages.mjs",
        "clean": "./scripts/clean.sh && npm run clean --workspace=packages/rules-engine"
    },
    "devDependencies": {
        "@dhis2/cli-app-scripts": "^12.11.8",
        "@types/express": "^4.17.21",
        "@types/node": "^22.14.0",
        "@types/react": "18.3.1",
        "@types/react-dom": "18.3.1",
        "@types/react-router-dom": "^5.3.3",
