        "redux-devtools-extension": "^2.13.9",
        "tsx": "^4.21.0",
        "typescript": "^5.8.2"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
